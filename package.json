{
  "name": "hibi-class-manager",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/check-build-budget.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:components": "vitest run .component.test.jsx",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2ee-performance": "node scripts/e2ee-performance.mjs",
    "test:db": "supabase db reset --local && supabase db lint --local --level warning --fail-on warning && supabase test db && node scripts/test-recovery-sql.mjs",
    "quality": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.1.0",
    "@supabase/supabase-js": "2.112.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "31.0.0",
    "prettier": "^3.9.10",
    "supabase": "^3.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
