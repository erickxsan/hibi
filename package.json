{
  "name": "hibi-class-manager",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:components": "vitest run .component.test.jsx",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2ee-performance": "node scripts/e2ee-performance.mjs",
    "test:db": "supabase db reset --local && supabase db lint --local --level warning --fail-on warning && supabase test db",
    "quality": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.1.0",
    "@supabase/supabase-js": "2.112.3",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "jsdom": "25.0.1",
    "prettier": "^3.9.6",
    "supabase": "^2.113.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
