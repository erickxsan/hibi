{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src/domain/**/*.js", "src/utils/**/*.js", "vite.config.js", "playwright.config.js", "tests/e2e/**/*.js"],
  "exclude": ["src/**/*.test.js"]
}
