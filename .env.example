# Public browser configuration. Never place a service-role or secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional hardening for legacy email/password sign-in. Google OAuth registration
# does not use this widget. Set the public key before enabling hCaptcha in Supabase.
# VITE_HCAPTCHA_SITE_KEY=YOUR_HCAPTCHA_SITE_KEY

# Only set this for an intentional private/offline production build. Never set
# it on the public Cloudflare deployment, which should fail closed if cloud
# configuration is missing.
# VITE_ALLOW_LOCAL_MODE=true

# Development-only QA switch. This is ignored by production builds and lets
# maintainers test local fixtures without signing into or mutating cloud data.
# VITE_FORCE_LOCAL_MODE=true

# Local development is read-only against cloud data by default. Prefer a
# separate staging Supabase project. Only enable this temporarily when you
# intentionally need to perform maintenance writes from localhost.
# VITE_ENABLE_CLOUD_WRITES_IN_DEV=true

# Production cloud writes are accepted only from this comma-separated origin
# allow-list. The default is https://usehibi.pages.dev. Add a custom production
# domain here when one is introduced; never add Cloudflare preview URLs.
# VITE_CLOUD_WRITE_ORIGINS=https://usehibi.pages.dev,https://hibi.example
