# Public browser configuration. Never place a service-role or secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional hardening for legacy email/password sign-in. Google OAuth registration
# does not use this widget. Set the public key before enabling hCaptcha in Supabase.
# VITE_HCAPTCHA_SITE_KEY=YOUR_HCAPTCHA_SITE_KEY

# Only set this for an intentional private/offline production build. Never set
# it on the public Cloudflare deployment, which should fail closed if cloud
# configuration is missing.
# VITE_ALLOW_LOCAL_MODE=true
